# CampusMatch 環境變數範例（複製成 .env 後填值；.env 不要提交到版本庫）
# 啟動時載入：set -a; source .env; set +a; java -jar backend/target/campus-match-1.0.0.jar

# ── 資料庫 ──────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campus
SPRING_DATASOURCE_USERNAME=campus
SPRING_DATASOURCE_PASSWORD=campus

# ── 啟動模式 ────────────────────────────────────────────
APP_SEED_MODE=demo            # demo：50 位虛構示範學生＋劇本資料；reference：正式上線，只載入參考資料（科目表、技能、競賽、教師）
APP_RESET_ON_START=true       # true：每次啟動重建 schema（Demo）；正式環境務必設為 false
APP_DEMO_CLOCK=true           # 允許管理員快轉時間（Demo）；正式環境設為 false
APP_DEMO_PASSWORD=demo1234    # 示範帳號的密碼（提供評審測試帳號時請改掉）
APP_JWT_SECRET=               # 正式環境必填：至少 32 字元的隨機字串
APP_ADMIN_EMAIL=              # reference 模式：啟動時若不存在則建立這個管理員
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=系統管理員

# ── Claude API（AI 助理入口、課綱／簡章的 AI 擷取）─────────────
# 不填金鑰時整個系統照常運作：AI 助理改用規則模式，AI 擷取改用關鍵字比對。
# 只讀 APP_ANTHROPIC_* 這組名稱；主機上其他用途的 ANTHROPIC_* 變數不會被當成本系統的設定。
APP_ANTHROPIC_API_KEY=
APP_ANTHROPIC_MODEL=claude-sonnet-5-5          # AI 助理（多步驟工具呼叫）
APP_ANTHROPIC_MODEL_FAST=claude-haiku-5-5      # 擷取與對照（短文、量大）
APP_ANTHROPIC_VERSION=2023-06-01               # anthropic-version 標頭
APP_ANTHROPIC_BASE_URL=https://api.anthropic.com
APP_ANTHROPIC_TIMEOUT=90                       # 每次呼叫的逾時秒數
APP_ANTHROPIC_EXTRA_BODY=                      # 選用：併入請求的 JSON 物件（模型專屬參數）
APP_ANTHROPIC_PRICE_IN=2.0                     # 成本估算用單價（美元／百萬 token）；換模型時一併調整，實際以帳單為準
APP_ANTHROPIC_PRICE_OUT=10.0
APP_SYLLABUS_FETCH=true                        # 是否向逢甲課程檢索系統擷取公開課綱；關閉時只用科目名稱對照技能

# ── APNs 推播（選用）────────────────────────────────────
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tw.edu.fcu.campusmatch
APNS_SANDBOX=true
